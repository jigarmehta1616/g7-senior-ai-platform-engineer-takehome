# Copy to .env for overrides. Defaults are safe for local use only; the API refuses to
# start with the local secrets when ENV is anything other than local/test.
ENV=local
UPSTREAM_BASE_URL=http://127.0.0.1:8081
JWT_SECRET=change-me-in-any-shared-environment
CURSOR_SECRET=change-me-in-any-shared-environment
RATE_LIMIT_USER_PER_MIN=120
RATE_LIMIT_AGENT_PER_MIN=30
# MCP server
PLATFORM_API_URL=http://127.0.0.1:8080
COPILOT_PERSONA=support-lead
